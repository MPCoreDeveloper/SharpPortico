<Project>
  <!--
    SharpPortico centralized build properties.

    .NET forward-compat strategy:
      * The product ships on net10.0 AND net11.0 from one branch. What ships, and what is tested, is
        SharpPorticoNetTargetFrameworks; the source generator stays on netstandard2.0 because Roslyn loads
        analyzers on that TFM - it is a hard requirement, not a downgrade, and it is also what makes the
        package usable from any consumer TFM.
      * LangVersion is preview for this repository's own code. Multi-targeting is what keeps that honest:
        code that needs a .NET 11 API does not compile against net10, so the second target framework is a
        check rather than a claim.
  -->

  <PropertyGroup>
    <!-- The TFM a project uses when it targets one runtime (samples, and the default). -->
    <SharpPorticoNetTargetFramework>net11.0</SharpPorticoNetTargetFramework>
    <!-- The runtimes the product ships on, and every framework the tests run against. -->
    <SharpPorticoNetTargetFrameworks>net10.0;net11.0</SharpPorticoNetTargetFrameworks>
    <!-- TFM for compiler-hosted assemblies (source generator + abstractions) -->
    <SharpPorticoGeneratorTargetFramework>netstandard2.0</SharpPorticoGeneratorTargetFramework>
    <SharpPorticoLangVersion>preview</SharpPorticoLangVersion>
    <SharpPorticoProductVersion>1.1.0</SharpPorticoProductVersion>
    <!-- AssemblyVersion/FileVersion must be numeric; the package version may carry a prerelease suffix. -->
    <SharpPorticoAssemblyVersion>1.1.0.0</SharpPorticoAssemblyVersion>
    <!-- Centralized versioning: every packable/runnable assembly uses the product version above. -->
    <Version>$(SharpPorticoProductVersion)</Version>
    <AssemblyVersion>$(SharpPorticoAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(SharpPorticoAssemblyVersion)</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>$(SharpPorticoLangVersion)</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1701;CS1702</NoWarn>
    <DebugType>portable</DebugType>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup>
    <!-- NuGet metadata shared by all packable projects -->
    <Authors>MPCoreDeveloper</Authors>
    <Company>MPCoreDeveloper</Company>
    <Copyright>Copyright (c) 2026 MPCoreDeveloper</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/MPCoreDeveloper/SharpPortico</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MPCoreDeveloper/SharpPortico.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>openapi;grpc;protobuf;source-generator;incremental-generator;dotnet;csharp;aot;proxy;cache</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <!-- NuGet: package icon (SharpPortico logo) + per-package readme + output folder -->
    <PackageIcon>docs\assets\SharpPortico.jpg</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts</PackageOutputPath>
  </PropertyGroup>

  <!-- Pack the SharpPortico logo and each package's short README into every packable project. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)docs\assets\SharpPortico.jpg" Pack="true" PackagePath="docs\assets\SharpPortico.jpg" Visible="false" />
    <None Include="$(MSBuildProjectDirectory)\README.md" Pack="true" PackagePath="\" Visible="false" Condition="Exists('$(MSBuildProjectDirectory)\README.md')" />
  </ItemGroup>
</Project>