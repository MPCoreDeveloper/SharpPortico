<Project>
  <!-- Central package management: single source of truth for package versions. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compiler / generator -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />

    <!--
      OpenAPI parsing (netstandard2.0 compatible, YAML + JSON).

      Both are held below the newest release on purpose, because they are not ordinary dependencies: the
      parser is copied into the analyzer package and loaded by Roslyn inside the consumer's compiler
      process, so what a package version means here is "what the compiler host can load".

        * Microsoft.OpenApi 1.6.31 is the last of the 1.6 line, and the whole mapping layer is written
          against its object model. 2.x/3.x replace that model and read 3.1 themselves, which is work on
          Mapping/ (and retires OpenApi31Downgrade.cs), not a version bump.
        * SharpYaml 2.1.5 is the last of the 2.x line, and its netstandard2.0 asset has no dependencies,
          which is why the analyzer package can ship SharpYaml.dll alone. 3.x's netstandard2.0 asset
          depends on System.Text.Json, System.Buffers and System.Collections.Immutable - assemblies the
          package does not ship - so a consumer whose compiler runs on .NET Framework (Visual Studio)
          would fail to load it on the 3.1 path.
    -->
    <PackageVersion Include="Microsoft.OpenApi" Version="1.6.31" />
    <PackageVersion Include="Microsoft.OpenApi.Readers" Version="1.6.31" />
    <PackageVersion Include="SharpYaml" Version="2.1.5" />

    <!-- Runtime contracts emitted by generated code -->
    <PackageVersion Include="Google.Protobuf" Version="3.36.2" />
    <PackageVersion Include="Grpc.Core.Api" Version="2.84.0" />
    <!-- Grpc.Core is the legacy native transport; 2.46.6 is the last release it ever had. -->
    <PackageVersion Include="Grpc.Core" Version="2.46.6" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.84.0" />
    <PackageVersion Include="Grpc.AspNetCore" Version="2.84.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
    <PackageVersion Include="System.Text.Json" Version="10.0.12" />

    <!-- CLI tooling (stable System.CommandLine) -->
    <PackageVersion Include="System.CommandLine" Version="2.0.12" />

    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>
</Project>