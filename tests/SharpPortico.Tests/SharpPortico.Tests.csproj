<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The tests run on every framework the product ships on, which is what makes "we support both" a
         fact rather than an intention. -->
    <TargetFrameworks>$(SharpPorticoNetTargetFrameworks)</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>SharpPortico.Tests</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.OpenApi.Readers" />
    <PackageReference Include="SharpYaml" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Core.Api" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SharpPortico.SourceGenerator\SharpPortico.SourceGenerator.csproj" />
    <!--
      The gateway emission names SharpPortico.Proxy types, so compiling what the generator emits only proves
      something when the runtime those names come from is in the test's own output directory: the compiler
      resolves references from there.
    -->
    <ProjectReference Include="..\..\src\SharpPortico.Runtime\SharpPortico.Runtime.csproj" />
    <!--
      The CLI is driven in-process through Program.RunAsync: the tests exercise the real argument parsing, the
      real mapping pipeline and the real exit codes with injected writers, so no test redirects the console and
      two tests can run side by side. The CLI exposes its internals to this assembly for exactly that seam.
    -->
    <ProjectReference Include="..\..\src\SharpPortico.Cli\SharpPortico.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="openapi\*.yaml" CopyToOutputDirectory="PreserveNewest" />
    <!-- The golden reports travel with the tests: they are the expected output, not fixtures to re-create. -->
    <None Update="openapi\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="openapi\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>